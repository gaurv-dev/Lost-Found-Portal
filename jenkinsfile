pipeline {

    agent any

    stages {

        stage('Checkout') {

            steps {

                git branch: 'main', url: 'https://github.com/gaurv-dev/Lost-Found-Portal.git'

            }

        }

        stage('Build') {

            steps {

                echo 'Building the frontend...'

            }

        }

        stage('Test') {

            steps {

                echo 'Running tests...'

            }

        }

        stage('Package') {

            steps {

                echo 'Packaging application...'

              

            }

        }

    }

    post {

        success {

            echo 'SUCCESS: Build pipeline complete.'

        }

        failure {

            echo 'FAILURE: Check the logs for the failed stage.'

        }

    }

}
